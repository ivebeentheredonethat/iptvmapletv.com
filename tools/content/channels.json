   "t": "rawhtml",
   "text": "IPTV Maple Channels List 📺 IPTV Maple Channels List 🇨🇦 Canada CBC HD CTV HD Global TV HD Sportsnet TSN 1 TSN 2 RDS 🇺🇸 USA ABC HD NBC HD FOX HD ESPN ESPN 2 HBO Showtime 🇬🇧 United Kingdom BBC One BBC Two ITV Sky Sports Premier League BT Sport 1",
   "raw": "\n<!DOCTYPE html>\n\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\"/>\n<title>IPTV Maple Channels List</title>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<style>\nbody {\n    font-family: Arial, sans-serif;\n    background: #0f172a;\n    color: #e5e7eb;\n    margin: 0;\n    padding: 20px;\n}\n\n.container {\n    max-width: 900px;\n    margin: auto;\n}\n\nh1 {\n    text-align: center;\n    margin-bottom: 20px;\n}\n\n#searchInput {\n    width: 100%;\n    padding: 12px;\n    font-size: 16px;\n    margin-bottom: 20px;\n    border-radius: 6px;\n    border: none;\n}\n\n.country {\n    margin-bottom: 15px;\n    border-radius: 8px;\n    overflow: hidden;\n    background: #020617;\n}\n\n.country-toggle {\n    width: 100%;\n    text-align: left;\n    padding: 15px;\n    font-size: 18px;\n    background: #7c2d4e;\n    color: #fff;\n    border: none;\n    cursor: pointer;\n}\n\n.country-toggle:hover {\n    background: #9f3c64;\n}\n\n.channel-list {\n    list-style: none;\n    margin: 0;\n    padding: 10px 20px;\n    display: none;\n}\n\n.channel-list li {\n    padding: 6px 0;\n    border-bottom: 1px solid #1e293b;\n}\n\n.channel-list li:last-child {\n    border-bottom: none;\n}\n</style>\n</head>\n<body>\n<div class=\"container\">\n<h1>📺 IPTV Maple Channels List</h1>\n<input id=\"searchInput\" placeholder=\"Search channels or countries...\" type=\"text\"/>\n<div class=\"country\">\n<button class=\"country-toggle\">🇨🇦 Canada</button>\n<ul class=\"channel-list\">\n<li>CBC HD</li>\n<li>CTV HD</li>\n<li>Global TV HD</li>\n<li>Sportsnet</li>\n<li>TSN 1</li>\n<li>TSN 2</li>\n<li>RDS</li>\n</ul>\n</div>\n<div class=\"country\">\n<button class=\"country-toggle\">🇺🇸 USA</button>\n<ul class=\"channel-list\">\n<li>ABC HD</li>\n<li>NBC HD</li>\n<li>FOX HD</li>\n<li>ESPN</li>\n<li>ESPN 2</li>\n<li>HBO</li>\n<li>Showtime</li>\n</ul>\n</div>\n<div class=\"country\">\n<button class=\"country-toggle\">🇬🇧 United Kingdom</button>\n<ul class=\"channel-list\">\n<li>BBC One</li>\n<li>BBC Two</li>\n<li>ITV</li>\n<li>Sky Sports Premier League</li>\n<li>BT Sport 1</li>\n</ul>\n</div>\n</div>\n<script>\n// Manual toggle (click)\ndocument.querySelectorAll(\".country-toggle\").forEach(button => {\n    button.addEventListener(\"click\", () => {\n        const list = button.nextElementSibling;\n        list.style.display = list.style.display === \"block\" ? \"none\" : \"block\";\n    });\n});\n\n// Search channels + countries\ndocument.getElementById(\"searchInput\").addEventListener(\"keyup\", function () {\n    const query = this.value.toLowerCase();\n\n    document.querySelectorAll(\".country\").forEach(country => {\n        const buttonText = country.querySelector(\".country-toggle\").textContent.toLowerCase();\n        const list = country.querySelector(\".channel-list\");\n\n        let channelMatchFound = false;\n\n        // Check channels\n        country.querySelectorAll(\"li\").forEach(channel => {\n            const match = channel.textContent.toLowerCase().includes(query);\n            channel.style.display = match ? \"block\" : \"none\";\n            if (match) channelMatchFound = true;\n        });\n\n        const countryMatch = buttonText.includes(query);\n\n        if (query !== \"\" && (countryMatch || channelMatchFound)) {\n            country.style.display = \"block\";\n            list.style.display = \"block\";\n\n            // If country matches, show all its channels\n            if (countryMatch && !channelMatchFound) {\n                country.querySelectorAll(\"li\").forEach(channel => {\n                    channel.style.display = \"block\";\n                });\n            }\n        } else if (query !== \"\") {\n            country.style.display = \"none\";\n            list.style.display = \"none\";\n        } else {\n            // Reset when empty\n            country.style.display = \"block\";\n            list.style.display = \"none\";\n            country.querySelectorAll(\"li\").forEach(channel => {\n                channel.style.display = \"block\";\n            });\n        }\n    });\n});\n</script>\n<script crossorigin=\"anonymous\" data-cf-beacon='{\"version\":\"2024.11.0\",\"token\":\"d53ee7f11a3545f286a5f67513870f91\",\"r\":1,\"spa\":2}' integrity=\"sha512-iIg7k2xntmwu6/uSb5tpc/hySgZc4eoL31yB29W6tJFo2akwjPWcEqnCEdJvGexCL0KEQwVYv5BlowfhVz26hg==\" src=\"https://static.cloudflareinsights.com/beacon.min.js/v31edd6df95cf4e85bb4c19e7a9bdbcba1788362987495\" type=\"module\"></script>\n</body>\n</html>\n"
  }
